# Void Walker Game Configuration
# Copy this file to .env and fill in your values

# Stripe API Keys
STRIPE_API_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Game Settings
GAME_NAME=Void Walker
VERSION=0.1.0-alpha
BASE_URL=http://localhost:3000

# Hugging Face API (for game-asset-mcp)
HUGGINGFACE_API_KEY=hf_your_huggingface_key_here

# Summer Engine
SUMMER_ENGINE_URL=http://localhost:8080

# Database (if using)
DATABASE_URL=postgresql://user:password@localhost:5432/voidwalker

# Logging
LOG_LEVEL=info
